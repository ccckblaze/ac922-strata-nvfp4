# Machine layout for the AC922 NVFP4 lane.  Copy to /data/work/lane.env (or point LANE_ENV at it);
# lane.sh sources it before anything else, so a shortcut script never has to restate the box.
# Everything here honours an already-set variable, so a one-off experiment can still override.
export AC922_ROOT=${AC922_ROOT:-/data/work}
export SRC=${SRC:-/data/work/ac922-strata-nvfp4}          # engine + serve + vision + shim all run from the repo
export MODEL_DIR=${MODEL_DIR:-/data/work/Strata-data/models/nvfp4-gptq}
export LOGD=${LOGD:-/data/champion}                        # engine log: $LOGD/strata-nvfp4-engine.log
export RUN_JSON=${RUN_JSON:-/data/work/strata-nvfp4.run.json}
export PIDF=${PIDF:-/tmp/strata-nvfp4-run.pid}
export NUMABIND_SO=${NUMABIND_SO:-/data/work/numabind.so}  # missing => lane.sh refuses to boot (remote reads)

# Observation switches.  lane.sh parses CARDS before sourcing this file, so lines can branch on
# the card count.  The 4-card production lane ships decode-window timing on (one stderr line per
# request, cumulative counters only - no diagnostic kernels, no extra sync):
[ "${CARDS:-}" = "4" ] && export STRATA_DECODE_TIMING=1

# Placement switch.  STRATA_NUMA_DROP decides whether the complement's NUMA placement may release the
# model files' cached pages: auto (default) asks needs_drop - is any node unable to take its slice plus
# half the pace reserve; =never keeps them (the page-lock still completes, measured on dev, but the
# toucher then allocates remotely: slice 0 ended at 0.1 % local, so the split pays for the pages in
# remote reads); =always releases as the pre-937b4ac50 builds did.  On this box the release is normally
# justified by the host itself: the pack's page cache sits almost entirely on node 0 while the
# complement is split evenly.  See DEVLOG H.30.
# export STRATA_NUMA_DROP=auto

# Prefill chunk.  `--prefill auto` sizes the chunk from what the expert caches can lend *at boot*, and
# with the cold tier's page cache busy that has been settling one notch down per boot (32768 -> 16384 ->
# 8192).  Asking for the ceiling explicitly costs nothing - the engine still clamps it down to what every
# expert cache can hold, and prints the clamp (`prompt chunk 32768 -> 16384 tokens so its buffers fit in
# every expert cache`) - but it no longer rides the drift.  Paired cold contention on 4 cards (a ~220K
# token cold prompt with a 64-token prompt sent 12 s after it):
#
#   chunk (effective) | deep wall | small wall | cold prefill tok/s
#   auto -> 8192      | 80.5 s    | 65.9 s     | 2740
#   ask 32768 -> 16384| 65.3 s    | 51.6 s     | 3381
#
# so ~+16-23 % on cold prefill and ~-22 % on the stall it causes for everyone else.  Chunk-class gate
# (`bash ac922/eval/selfcheck.sh <TAG>`) => ALL-EQ at 8.5K/64K/131K.  See DEVLOG H.31.
export PREFILL_CHUNK=${PREFILL_CHUNK:-32768}
